PORT=5000
MONGODB_URI=mongodb://localhost:27017/political-poster-db
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cloud Storage Configuration (Supports DigitalOcean Spaces, AWS S3, or Cloudinary)

# Option A: DigitalOcean Spaces (S3-Compatible - Recommended if using DigitalOcean)
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com    # (e.g. sgp1, nyc3, fra1)
# S3_REGION=sgp1
# S3_BUCKET=your-spaces-bucket-name
# S3_ACCESS_KEY_ID=DO00...
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_CDN_URL=https://your-spaces-bucket-name.sgp1.cdn.digitaloceanspaces.com  # (Optional CDN URL)

# Option B: AWS S3
# S3_REGION=ap-southeast-1                         # (e.g. ap-southeast-1, us-east-1)
# S3_BUCKET=your-aws-s3-bucket-name
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=your_aws_secret_key

# Option C: Cloudinary (Optional fallback)
# CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

